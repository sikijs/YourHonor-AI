FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# tesseract-ocr: the OCR engine behind scanned-PDF support (pytesseract wraps
# this binary; PyMuPDF renders PDF pages to images without system poppler).
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

RUN pip install uv

COPY backend/pyproject.toml ./

RUN uv sync

# Pre-download the embedding model at build time so fresh containers can start
# ingesting immediately instead of stalling ~1-2 minutes on the first boot
# while the model downloads from HuggingFace. The cache (~/.cache/huggingface)
# becomes part of this image layer.
RUN .venv/bin/python3 -c "from langchain_huggingface import HuggingFaceEmbeddings; HuggingFaceEmbeddings(model_name='sentence-transformers/all-MiniLM-L6-v2')"

COPY backend/ .
COPY catalog.json ./
COPY templates ./templates
COPY docs/ ./docs

EXPOSE 8000

# MC_QUIZ_FIX
CMD [".venv/bin/python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]