FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# tesseract-ocr: the OCR engine behind scanned-PDF support (pytesseract wraps
# this binary; PyMuPDF renders PDF pages to images without system poppler).
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

RUN pip install uv

COPY backend/pyproject.toml ./

RUN uv sync

COPY backend/ .
COPY catalog.json ./
COPY templates ./templates
COPY docs/ ./docs

EXPOSE 8000

# MC_QUIZ_FIX
CMD [".venv/bin/python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]